msgstr "Spiele externe Videos synchron für alle ab."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Hold participants until admitted."
msgstr "Halten Sie die Teilnehmer bis zur Aufnahme zurück."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Split participants into sub-rooms."
msgstr "Teile die Teilnehmer in Unterräume auf."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Show external content inside the session."
msgstr "Zeigen Sie externe Inhalte innerhalb der Sitzung an."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Push high-quality streams via OBS/RTMP/WHIP."
msgstr "Pushe hochwertige Streams über OBS/RTMP/WHIP."

#: admin/partials/plugnmeet-admin-edit-room.php
