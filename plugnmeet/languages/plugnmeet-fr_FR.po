msgstr "Identité de la chambre, mots de passe et message de bienvenue."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Webcams, screen sharing and more."
msgstr "Webcams, partage d’écran et plus encore."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Record on the server or locally."
msgstr "Enregistrez sur le serveur ou localement."

#: admin/partials/plugnmeet-admin-edit-room.php
msgid "Stream the session to external platforms."
msgstr "Diffusez la session sur des plateformes externes."

#: admin/partials/plugnmeet-admin-edit-room.php
